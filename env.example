DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mcb_tester"
NEXT_PUBLIC_APP_MODE="SIMULATION"
NEXT_PUBLIC_APP_NAME="Smart MCB Tester"# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Smart MCB Tester
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcb_tester

# Authentication
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Hardware gateway
HARDWARE_MODE=SIMULATION
HARDWARE_GATEWAY_URL=http://localhost:4100
HARDWARE_GATEWAY_API_KEY=replace-me

# Telemetry
TELEMETRY_TRANSPORT=SSE
TELEMETRY_SAMPLE_MS=250

# AI
AI_PROVIDER=mock
AI_MODEL=
AI_API_KEY=

# Reports
REPORT_STORAGE=local
REPORT_STORAGE_PATH=./storage/reports

# Security
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true

# Feature flags
ENABLE_REAL_DEVICE=false
ENABLE_AI_INSPECTOR=true
ENABLE_QR_SCANNER=true
ENABLE_REPORTS=true
